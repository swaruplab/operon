<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Monaco/V8 need JIT and writable+executable memory under hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Allow loading the bundled sidecars (anthropic-proxy, rg) signed with a different identity -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Microphone / voice dictation in the chat input -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- osascript / AppleEvents automation of terminal and dev tools -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
